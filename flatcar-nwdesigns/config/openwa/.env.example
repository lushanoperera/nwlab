# OpenWA on VM 104 — created 2026-10-02. Secrets live only here (mode 0600).
NODE_ENV=production
TZ=Europe/Rome
API_MASTER_KEY=CHANGE_ME
API_KEY_PEPPER=CHANGE_ME
DATABASE_TYPE=sqlite
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=true
BASE_URL=https://wa.nwlab.nwdesigns.it
DASHBOARD_URL=https://wa.nwlab.nwdesigns.it
# Caddy reaches OpenWA over traefik-public; its IP changes on recreate, so trust the subnet.
TRUSTED_PROXIES=172.20.0.0/16
# Stable node identity: the default (container hostname) changes on every recreate and delays session re-adoption.
NODE_ID=flatcar-portainer-104
